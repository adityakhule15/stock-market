DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DATABASE_URL=sqlite:///db.sqlite3
DATA_PROVIDERS=yfinance,nse_eod
# LIVE_FEED_API_KEY=
# INDstocks — market DATA only (LTP / quotes / option chain). NEVER used to place orders.
# Get token: https://www.indstocks.com/app/api-trading/access-tokens  (expires ~24h — regenerate daily)
# INDSTOCKS_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Advisor free-form AI chat (optional — local keyword coach works without keys)
# Gemini free key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash   # gemini-2.0-flash was shut down Jun 2026
# DeepSeek: https://platform.deepseek.com
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# ADVISOR_AI_PROVIDER=auto   # auto|gemini|deepseek|local
# ADVISOR_AI_VOTE=1          # 1 = Gemini may advise at low weight; 0 = coach notes only

TIMEZONE=Asia/Kolkata
PORT=8001
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8001,http://localhost:8001
# One-process run (default on):
RUN_EMBEDDED_SCHEDULER=1
# USE_GUNICORN=1
# DISABLE_SCHEDULER=1

# ---------------------------------------------------------------------------
# Research agents (TradingAgents v0.7.1) — OPTIONAL, default OFF
# Install into a SEPARATE venv:  python -m venv .venv-ta
#   .venv-ta\Scripts\pip install -r requirements-tradingagents.txt
# Cost warning: one full multi-agent run = many LLM calls per symbol.
# Do NOT enable until you accept the cost. Never sends INDstocks/Groww tokens.
# ---------------------------------------------------------------------------
# AGENTS_ENABLED=0
# AGENTS_TOP_N=3
# AGENTS_DAILY_CALL_CAP=6
# AGENTS_DAILY_COST_CAP_INR=0
# AGENTS_RUN_TIMEOUT_SEC=600
# AGENTS_RETRY_BUDGET=1
# AGENTS_MAX_DEBATE_ROUNDS=1
# AGENTS_MAX_RISK_ROUNDS=1
# AGENTS_SELECTED_ANALYSTS=market,social,news,fundamentals
# AGENTS_CHECKPOINT_ENABLED=1
# TA_PYTHON=.venv-ta\Scripts\python.exe
# TA_RUNNER=scripts/ta_runner.py

# Paths (project-relative recommended)
# TRADINGAGENTS_RESULTS_DIR=artifacts/research
# TRADINGAGENTS_CACHE_DIR=data/tradingagents/cache
# TRADINGAGENTS_MEMORY_LOG_PATH=data/tradingagents/memory/trading_memory.md
TRADINGAGENTS_NO_UPDATE_CHECK=1

# Provider / tiers (DeepSeek → Gemini preferred for cheap experiments)
# TRADINGAGENTS_LLM_PROVIDER=deepseek
# TRADINGAGENTS_QUICK_THINK_LLM=deepseek-chat
# TRADINGAGENTS_DEEP_THINK_LLM=deepseek-chat
# TRADINGAGENTS_QUICK_THINK_PROVIDER=
# TRADINGAGENTS_DEEP_THINK_PROVIDER=
# TRADINGAGENTS_LLM_BACKEND_URL=
# TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
# TRADINGAGENTS_MAX_RISK_ROUNDS=1
# TRADINGAGENTS_CHECKPOINT_ENABLED=1
# TRADINGAGENTS_BENCHMARK_TICKER=^NSEI
# TRADINGAGENTS_OUTPUT_LANGUAGE=English

# LLM API keys (only the chosen provider is contacted)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# DASHSCOPE_CN_API_KEY=
# ZHIPU_API_KEY=
# ZHIPU_CN_API_KEY=
# MINIMAX_API_KEY=
# MINIMAX_CN_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# MOONSHOT_API_KEY=
# GROQ_API_KEY=
# NVIDIA_API_KEY=
# OPENAI_COMPATIBLE_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional data vendors — ask before enabling paid ones
# FRED_API_KEY=
# ALPHA_VANTAGE_API_KEY=
# TYPESAFE_API_KEY=
# SEC_EDGAR_USER_AGENT=StockScopeIndia your@email.com
