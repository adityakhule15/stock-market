# Kronos forecast sidecar (CPU torch) — isolated from Django / TradingAgents
FROM python:3.12-slim-bookworm

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    HF_HOME=/app/data/kronos/hf_cache \
    HUGGINGFACE_HUB_CACHE=/app/data/kronos/hf_cache

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-kronos.txt .
RUN pip install --no-cache-dir -r requirements-kronos.txt

COPY third_party/kronos /app/third_party/kronos
COPY scripts/kronos_runner.py /app/scripts/kronos_runner.py
RUN mkdir -p /app/data/kronos/hf_cache /app/artifacts/kronos

ENV PYTHONPATH=/app/third_party/kronos
ENTRYPOINT ["python", "/app/scripts/kronos_runner.py"]
